<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Tambah Lapangan | Sportify Admin</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body>
    <div class="admin-container">
        <main class="main-content" style="padding: 40px; max-width: 600px; margin: auto;">
            <header style="margin-bottom: 30px;">
                <h1>Tambah Lapangan Baru</h1>
                <p style="color: #78909c;">Lengkapi data lapangan untuk ditampilkan di halaman user.</p>
            </header>

            <form action="/admin/fasilitas/tambah" method="POST" style="background: #fff; padding: 30px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Nama Lapangan</label>
                    <input type="text" name="nama_fasilitas" placeholder="Contoh: Lapangan Volly" required style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px;">
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Harga per Jam (Rp)</label>
                    <input type="number" name="harga_per_jam" placeholder="Contoh: 50000" required style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px;">
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Deskripsi</label>
                    <textarea name="deskripsi" placeholder="Tuliskan deskripsi lapangan..." style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px; height: 100px;"></textarea>
                </div>
                
                <div style="margin-bottom: 20px;">
                    <label style="display: block; margin-bottom: 8px; font-weight: 600;">Nama File Foto</label>
                    <input type="text" name="foto" placeholder="Contoh: volly.jpg" required style="width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 5px;">
                    <small style="color: #90a4ae;">*Pastikan file foto sudah ada di folder public/images/</small>
                </div>
                
                <div style="display: flex; gap: 10px; margin-top: 30px;">
                    <button type="submit" style="background: #2e7d32; color: white; border: none; padding: 12px 25px; border-radius: 5px; cursor: pointer; font-weight: 600;">
                        <i class="fas fa-save"></i> Simpan Lapangan
                    </button>
                    <a href="/admin/fasilitas" style="background: #90a4ae; color: white; padding: 12px 25px; border-radius: 5px; text-decoration: none; font-weight: 600;">
                        Batal
                    </a>
                </div>
            </form>
        </main>
    </div>
</body>
</html>