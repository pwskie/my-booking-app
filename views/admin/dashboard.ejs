<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin | Sportify</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Segoe+UI:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <div class="admin-container">
        <aside class="sidebar">
            <div class="sidebar-logo">
                <h2><i class="fas fa-running"></i> SPORTIFY</h2>
            </div>
            <nav style="margin-top: 40px;">
                <a href="/admin/dashboard" class="active"><i class="fas fa-home"></i> Dashboard</a>
                <a href="/admin/fasilitas"><i class="fas fa-dumbbell"></i> Kelola Lapangan</a>
                <a href="/admin/users"><i class="fas fa-users"></i> Daftar User</a>
                <a href="/logout" style="margin-top: 50px; color: #e57373;"><i class="fas fa-sign-out-alt"></i> Logout</a>
            </nav>
        </aside>

        <main class="main-content">
            <header style="margin-bottom: 40px;">
                <h1 style="margin: 0; color: #37474f;">Selamat Datang, Admin <%= user %></h1>
                <p style="color: #78909c;">Pantau aktivitas booking Sportify hari ini.</p>
            </header>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px;">
                <div style="background: white; padding: 25px; border-radius: 15px; border-left: 5px solid #2e7d32; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                    <h3 style="margin: 0; color: #90a4ae; font-size: 0.9rem;">TOTAL BOOKING</h3>
                    <p style="font-size: 2rem; font-weight: bold; margin: 10px 0; color: #263238;"><%= bookings.length %></p>
                    <small style="color: #2e7d32;"><i class="fas fa-arrow-up"></i> Data Berhasil Dimuat</small>
                </div>
                <div style="background: white; padding: 25px; border-radius: 15px; border-left: 5px solid #ffa000; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                    <h3 style="margin: 0; color: #90a4ae; font-size: 0.9rem;">BOOKING PENDING</h3>
                    <p style="font-size: 2rem; font-weight: bold; margin: 10px 0; color: #263238;">
                        <%= bookings.filter(b => b.status === 'pending').length %>
                    </p>
                    <small style="color: #ffa000;">Perlu Konfirmasi</small>
                </div>
                <div style="background: white; padding: 25px; border-radius: 15px; border-left: 5px solid #1976d2; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                    <h3 style="margin: 0; color: #90a4ae; font-size: 0.9rem;">BOOKING CONFIRMED</h3>
                    <p style="font-size: 2rem; font-weight: bold; margin: 10px 0; color: #263238;">
                        <%= bookings.filter(b => b.status === 'confirmed').length %>
                    </p>
                    <small style="color: #1976d2;">Jadwal Aktif</small>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 30px;">
                <div style="background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                    <h3 style="color: #37474f; margin-bottom: 20px;">Visualisasi Status</h3>
                    <canvas id="statusChart"></canvas>
                </div>

                <div style="background: white; padding: 20px; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                    <h3 style="color: #37474f; margin-bottom: 20px;">Riwayat Booking Terbaru</h3>
                    <table class="table">
    <thead>
        <tr>
            <th>User</th>
            <th>Lapangan</th>
            <th>Tanggal</th>
            <th>Status</th>
            <th>Aksi</th>
        </tr>
    </thead>
    <tbody>
        <% if (bookings.length > 0) { %>
            <% bookings.forEach(b => { %>
                <tr>
                    <td><%= b.username %></td>
                    <td><%= b.nama_fasilitas %></td>
                    <td><%= b.tanggal %></td>
                    <td><span class="badge"><%= b.status %></span></td>
                    <td>
                        <form action="/admin/update-status" method="POST">
                            <input type="hidden" name="id" value="<%= b.id %>">
                            <select name="status" onchange="this.form.submit()">
                                <option value="pending" <%= b.status == 'pending' ? 'selected' : '' %>>Pending</option>
                                <option value="approved" <%= b.status == 'approved' ? 'selected' : '' %>>Approved</option>
                            </select>
                        </form>
                    </td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr>
                <td colspan="5" style="text-align: center;">Belum ada booking masuk.</td>
            </tr>
        <% } %>
    </tbody>
</table>
                </div>
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('statusChart').getContext('2d');
        const statusChart = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Pending', 'Confirmed'],
                datasets: [{
                    data: [
                        <%= bookings.filter(b => b.status === 'pending').length %>,
                        <%= bookings.filter(b => b.status === 'confirmed').length %>
                    ],
                    backgroundColor: ['#ffa000', '#2e7d32'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>
</body>
</html>