<%- include('partials/header') %>

<div class="container" style="padding: 40px;">
    <h2>Jadwal Booking Lapangan</h2>
    <table border="1" style="width: 100%; border-collapse: collapse; margin-top: 20px;">
        <tr style="background: #f4f4f4;">
            <th style="padding: 10px;">User</th>
            <th style="padding: 10px;">Lapangan</th>
            <th style="padding: 10px;">Tanggal</th>
            <th style="padding: 10px;">Waktu</th>
        </tr>
        <% if (jadwal && jadwal.length > 0) { %>
            <% jadwal.forEach(j => { %>
                <tr>
                    <td style="padding: 10px;"><%= j.username %></td>
                    <td style="padding: 10px;"><%= j.nama_fasilitas %></td>
                    <td style="padding: 10px;"><%= new Date(j.tanggal).toLocaleDateString('id-ID') %></td>
                    <td style="padding: 10px;"><%= j.jam_mulai.slice(0,5) %> - <%= j.jam_selesai.slice(0,5) %></td>
                </tr>
            <% }) %>
        <% } else { %>
            <tr><td colspan="4" style="text-align: center; padding: 20px;">Belum ada jadwal yang disetujui.</td></tr>
        <% } %>
    </table>
</div>

<%- include('partials/footer') %>